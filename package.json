{
  "name": "@murkio/angular",
  "version": "0.1.0",
  "description": "Murkio identity for Angular: provideMurkio(), auth signals, a route guard and an HTTP interceptor for the <murkio-identity-*> elements.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViitoJooj/murkio-angular.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "package:check": "publint --strict",
    "prepublishOnly": "node scripts/check-publishable.mjs"
  },
  "dependencies": {
    "@murkio/html": "github:ViitoJooj/murkio-html#4ccc8ea80507f56b11249a0a67045f93df4adfdd"
  },
  "peerDependencies": {
    "@angular/common": ">=17",
    "@angular/core": ">=17",
    "@angular/router": ">=17",
    "rxjs": "^7.4.0"
  },
  "devDependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "happy-dom": "21.0.1",
    "publint": "0.3.25",
    "rxjs": "7.8.2",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild": false,
    "github:ViitoJooj/murkio-html#4ccc8ea80507f56b11249a0a67045f93df4adfdd": true
  }
}
